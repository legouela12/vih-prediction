# OpenMRS REST API base URL; use localhost when FastAPI runs on the same host.
OPENMRS_BASE_URL=http://127.0.0.1:8080/openmrs/ws/rest/v1
OPENMRS_USERNAME=service_account
OPENMRS_PASSWORD=replace-me
OPENMRS_TIMEOUT=10
OPENMRS_INTEGRATION_TOKEN=generate-a-long-random-token
OPENMRS_FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
OPENMRS_PREDICTION_FORM_UUID=61465e23-9e77-4f68-aa3b-6a6d99773700

# CIEL concepts used for derived variables (stable UUIDs).
OPENMRS_CONCEPT_HIV_DIAGNOSIS_DATE=160554AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
OPENMRS_CONCEPT_CD4=5497AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
OPENMRS_ENCOUNTER_TYPE_ADMISSION=e22e39fd-7db2-45e7-80f1-60fa0d5a4378

# Local custom Boolean question concepts and Text result concept.
# Their UUIDs are saved in this PC's .env. Export/import these concepts to
# another OpenMRS instance, then put that instance's UUIDs here.
OPENMRS_CONCEPT_STADE_AVANCE=
OPENMRS_CONCEPT_NON_OBSERVANT=
OPENMRS_CONCEPT_VIT_SEUL=
OPENMRS_CONCEPT_ETUDE_SECONDAIRE_PLUS=
OPENMRS_CONCEPT_PREDICTION_RESULT=
